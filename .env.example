# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# Proveedor de IA compatible con OpenAI. Si LLM_API_KEY está vacío, Randall responde en modo FAQ (sin IA).
# Groq (gratis/rápido):     https://api.groq.com/openai/v1       modelo: openai/gpt-oss-120b
# Together:                 https://api.together.xyz/v1
# OpenAI:                   https://api.openai.com/v1            modelo: gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=800

# Base de conocimiento: la genera la landing desde sus textos (una sola fuente de verdad).
# Si la landing no responde, se usan los archivos de knowledge/ como respaldo.
KNOWLEDGE_URL=https://quasardevs.com/api/knowledge
KNOWLEDGE_TTL_SECONDS=600

# Orígenes permitidos (separados por coma, sin "/" final)
ALLOWED_ORIGINS=https://quasar-devs.vercel.app,http://localhost:3000

# Límite de preguntas por visitante (IP)
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
# Presupuesto global de IA (cuota de Groq). Al agotarse, Randall responde en modo FAQ.
LLM_GLOBAL_PER_MINUTE=2
LLM_GLOBAL_PER_DAY=55
# Rechaza llamadas sin un Origin permitido (scripts que llaman la API directo)
REQUIRE_ORIGIN=true
# Contadores compartidos (Upstash Redis). En Vercel: Storage → Upstash for Redis → conectar al proyecto.
# Si faltan, se usa memoria (protege mucho menos en Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# true solo si corre detrás de un proxy de confianza (Render, Railway, Fly.io, Nginx)
TRUST_PROXY=false
